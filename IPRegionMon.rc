    EDITTEXT        IDC_LAT_URL_EDIT,152,152,185,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Add / Update",IDC_LAT_ADD_BUTTON,345,151,69,14
    PUSHBUTTON      "Delete",IDC_LAT_DEL_BUTTON,10,172,42,14
    PUSHBUTTON      "Up",IDC_LAT_UP_BUTTON,58,172,42,14
    PUSHBUTTON      "Down",IDC_LAT_DOWN_BUTTON,106,172,42,14
    PUSHBUTTON      "Test Selected",IDC_LAT_TEST_BUTTON,325,172,89,14
    LTEXT           "Tip: Double-click an item to edit; URLs can include https:// or domain name.",IDC_STATIC,10,195,400,9
END

IDD_TAB_STATUS_INFO DIALOGEX 0, 0, 420, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Direct Network Status",IDC_GRP_DIRECT_STAT,6,4,408,58
    LTEXT           "Public IP: -",IDC_STAT_DIRECT_IP,16,17,210,9
    LTEXT           "Region: -",IDC_STAT_DIRECT_PLACE,16,31,210,9
    LTEXT           "ISP: -",IDC_STAT_DIRECT_ISP,16,45,210,9
