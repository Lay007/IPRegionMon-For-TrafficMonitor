    EDITTEXT        IDC_PROXY_EDIT,58,90,165,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Test Proxy",IDC_TEST_PROXY_BUTTON,230,89,65,14
    LTEXT           "",IDC_TEST_PROXY_STATUS,14,106,396,10

    LTEXT           "Direct API:",IDC_API_DOMESTIC_LABEL,14,142,40,9
    EDITTEXT        IDC_API_DOMESTIC_EDIT,58,140,352,12,ES_AUTOHSCROLL
    LTEXT           "Proxy API:",IDC_API_FOREIGN_LABEL,14,162,40,9
    EDITTEXT        IDC_API_FOREIGN_EDIT,58,160,352,12,ES_AUTOHSCROLL
    LTEXT           "Tip: Standard APIs supporting ASN & threat detection are recommended (e.g. ip-api.com).",IDC_STATIC,14,184,396,9
END

IDD_TAB_LATENCY_LIST DIALOGEX 0, 0, 426, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
