END

IDD_TAB_PROXY_API DIALOGEX 0, 0, 420, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Display Preferences & Updates",IDC_STATIC,6,4,408,52
    LTEXT           "Display Format:",IDC_DISPLAY_FORMAT_LABEL,15,18,50,9
    COMBOBOX        IDC_DISPLAY_FORMAT_COMBO,68,16,115,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Interval (s):",IDC_REFRESH_INTERVAL_LABEL,195,18,40,9
