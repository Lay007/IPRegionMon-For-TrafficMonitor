    LTEXT           "",IDC_TEST_PROXY_STATUS,15,104,390,10

    GROUPBOX        "IP Detection APIs",IDC_GRP_LATENCY,6,122,408,86
    LTEXT           "Direct API:",IDC_API_DOMESTIC_LABEL,15,138,40,9
    EDITTEXT        IDC_API_DOMESTIC_EDIT,60,136,346,12,ES_AUTOHSCROLL
    LTEXT           "Proxy API:",IDC_API_FOREIGN_LABEL,15,158,40,9
    EDITTEXT        IDC_API_FOREIGN_EDIT,60,156,346,12,ES_AUTOHSCROLL
    LTEXT           "Tip: Standard APIs supporting ASN & threat detection are recommended (e.g. ip-api.com).",IDC_STATIC,15,180,390,9
END

IDD_TAB_LATENCY_LIST DIALOGEX 0, 0, 420, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
