IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 440, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_CLIPCHILDREN | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IP Region & Latency Monitor Settings"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_TAB_MAIN,"Static",SS_NOTIFY | WS_CHILD | WS_VISIBLE,7,6,426,18
    DEFPUSHBUTTON   "OK",IDOK,315,248,56,15
    PUSHBUTTON      "Cancel",IDCANCEL,376,248,56,15
END

IDD_TAB_PROXY_API DIALOGEX 0, 0, 426, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Display Format:",IDC_DISPLAY_FORMAT_LABEL,14,18,50,9
    COMBOBOX        IDC_DISPLAY_FORMAT_COMBO,68,16,115,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Interval (s):",IDC_REFRESH_INTERVAL_LABEL,192,18,42,9
    EDITTEXT        IDC_REFRESH_INTERVAL_EDIT,238,16,34,12,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "Refresh Now",IDC_REFRESH_NOW_BUTTON,282,15,55,14
