#include "resource.h"
#include <windows.h>
#include "winres.h"

#undef APSTUDIO_READONLY_SYMBOLS

// 简体中文资源
#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)

// 主容器对话框
IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 440, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_CLIPCHILDREN | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IP 地区与网络监控设置"
FONT 9, "微软雅黑", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,315,248,56,15
    PUSHBUTTON      "取消",IDCANCEL,376,248,56,15
    CONTROL         "",IDC_TAB_MAIN,"SysTabControl32",WS_TABSTOP,7,7,426,234
END

// Tab 0: 常规与代理设置
IDD_TAB_PROXY_API DIALOGEX 0, 0, 420, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "微软雅黑", 400, 0, 0x0
BEGIN
    GROUPBOX        "展示偏好与更新",IDC_STATIC,6,4,408,52
    LTEXT           "任务栏格式:",IDC_DISPLAY_FORMAT_LABEL,15,18,45,9
    COMBOBOX        IDC_DISPLAY_FORMAT_COMBO,65,16,115,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "刷新间隔(秒):",IDC_REFRESH_INTERVAL_LABEL,195,18,50,9
    EDITTEXT        IDC_REFRESH_INTERVAL_EDIT,248,16,36,12,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "立即刷新",IDC_REFRESH_NOW_BUTTON,292,15,50,14
    LTEXT           "",IDC_STATUS_STATIC,65,37,340,11

    GROUPBOX        "代理连接 (用于国外出口及跨国测速)",IDC_GRP_PROXY,6,60,408,58
    CONTROL         "启用代理服务器",IDC_USE_PROXY_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,73,80,10
    LTEXT           "代理地址:",IDC_PROXY_LABEL,15,91,38,9
    EDITTEXT        IDC_PROXY_EDIT,56,89,170,12,ES_AUTOHSCROLL
    PUSHBUTTON      "测试代理连通性",IDC_TEST_PROXY_BUTTON,232,88,68,14
    LTEXT           "",IDC_TEST_PROXY_STATUS,15,104,390,10

    GROUPBOX        "公网 IP 探测接口 API",IDC_GRP_LATENCY,6,122,408,86
    LTEXT           "直连 API:",IDC_API_DOMESTIC_LABEL,15,138,36,9
    EDITTEXT        IDC_API_DOMESTIC_EDIT,56,136,350,12,ES_AUTOHSCROLL
    LTEXT           "代理 API:",IDC_API_FOREIGN_LABEL,15,158,36,9
    EDITTEXT        IDC_API_FOREIGN_EDIT,56,156,350,12,ES_AUTOHSCROLL
    LTEXT           "提示：推荐使用支持纯净度与 ASN 解析的 API (默认 ip-api.com，支持中文)",IDC_STATIC,15,180,390,9
END

// Tab 1: 延迟目标设置
IDD_TAB_LATENCY_LIST DIALOGEX 0, 0, 420, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "微软雅黑", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_LATENCY_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,6,4,408,140
    LTEXT           "名称:",IDC_STATIC,10,154,22,9
    EDITTEXT        IDC_LAT_NAME_EDIT,34,152,70,12,ES_AUTOHSCROLL
    LTEXT           "地址/URL:",IDC_STATIC,110,154,36,9
    EDITTEXT        IDC_LAT_URL_EDIT,148,152,190,12,ES_AUTOHSCROLL
    PUSHBUTTON      "添加/更新",IDC_LAT_ADD_BUTTON,345,151,69,14
    PUSHBUTTON      "删除",IDC_LAT_DEL_BUTTON,10,172,42,14
    PUSHBUTTON      "上移",IDC_LAT_UP_BUTTON,58,172,42,14
    PUSHBUTTON      "下移",IDC_LAT_DOWN_BUTTON,106,172,42,14
    PUSHBUTTON      "测速选中目标",IDC_LAT_TEST_BUTTON,325,172,89,14
    LTEXT           "提示：双击或点击列表项可快速载入编辑；地址可填域名或带 https:// 的完整 URL。",IDC_STATIC,10,195,400,9
END

// Tab 2: 当前状态与安全报告
IDD_TAB_STATUS_INFO DIALOGEX 0, 0, 420, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "微软雅黑", 400, 0, 0x0
BEGIN
    GROUPBOX        "直连网络状况",IDC_GRP_DIRECT_STAT,6,4,408,58
    LTEXT           "公网 IP: -",IDC_STAT_DIRECT_IP,16,17,210,9
    LTEXT           "地区: -",IDC_STAT_DIRECT_PLACE,16,31,210,9
    LTEXT           "运营商: -",IDC_STAT_DIRECT_ISP,16,45,210,9
    LTEXT           "网络属性与安全: -",IDC_STAT_DIRECT_THREAT,230,17,175,23
    PUSHBUTTON      "复制直连 IP",IDC_BTN_COPY_DIRECT,230,43,65,13

    GROUPBOX        "代理出口网络状况",IDC_GRP_PROXY_STAT,6,66,408,58
    LTEXT           "出口 IP: -",IDC_STAT_PROXY_IP,16,79,210,9
    LTEXT           "地区: -",IDC_STAT_PROXY_PLACE,16,93,210,9
    LTEXT           "运营商: -",IDC_STAT_PROXY_ISP,16,107,210,9
    LTEXT           "网络属性与安全: -",IDC_STAT_PROXY_THREAT,230,79,175,23
    PUSHBUTTON      "复制代理 IP",IDC_BTN_COPY_PROXY,230,105,65,13

    GROUPBOX        "完整探测诊断日志",IDC_STATIC,6,128,408,82
    EDITTEXT        IDC_STATUS_INFO_EDIT,12,139,330,66,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "复制全部文本",IDC_BTN_COPY_ALL,348,150,60,18
END

// Version
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "By HiTech_NinJa & Contributors"
            VALUE "FileDescription", "IP Region Monitor Plugin for TrafficMonitor"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "InternalName", "IPRegionMon.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "IPRegionMon.dll"
            VALUE "ProductName", "IPRegionMon"
            VALUE "ProductVersion", "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

// String Table
STRINGTABLE
BEGIN
    IDS_PLUGIN_NAME         "IP 地区监控插件"
    IDS_PLUGIN_DESCRIPTION  "显示当前公网 IP、地区、延迟及网络安全检测，支持代理与自定义展示。"
    IDS_CUSTOM_DRAW_ITEM    "IP"
    IDS_DIRECT_ITEM_NAME    "IP (直连)"
    IDS_PROXY_ITEM_NAME     "IP (代理)"
END

#endif

// 英文资源
#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
